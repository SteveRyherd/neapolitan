{
  "name": "Neapolitan Domain Switcher",
  "manifest_version": 3,
  "version": "1.0.1",
  "description": "Switch between development, staging, and production environments easily",
  "author": "Steve Ryherd",
  "homepage_url": "https://neapolitan.page",

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  
  "action": {
    "default_title": "Switch Environment",
    "default_popup": "src/popup/switcher.html",
    "default_icon": {
      "16": "icons/unmatched-16.png",
      "32": "icons/unmatched-32.png",
      "48": "icons/unmatched-32.png",
      "128": "icons/unmatched-32.png"
    }
  },

  "permissions": [
    "tabs",
    "storage"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/environments/110/PNG/icon-marketing-16.png",
    "32": "icons/environments/110/PNG/icon-marketing-32.png",
    "48": "icons/environments/110/PNG/icon-marketing-48.png",
    "128": "icons/environments/110/PNG/icon-marketing-128.png"
  },
  
  "commands": {
    "switch-1-development": {
      "suggested_key": {
        "mac": "Alt+X",
        "windows": "Alt+X",
        "linux": "Alt+X"
      },
      "description": "Switch to 1: development environment"
    },
    "switch-2-staging": {
      "suggested_key": {
        "mac": "Alt+S",
        "windows": "Alt+S",
        "linux": "Alt+S"
      },
      "description": "Switch to 2: staging environment"
    },
    "switch-3-production": {
      "suggested_key": {
        "mac": "Alt+W",
        "windows": "Alt+W",
        "linux": "Alt+W"
      },
      "description": "Switch to 3: production environment"
    },
    "_execute_action": {
      "description": "Open the environment switcher popup"
    }
  }
}